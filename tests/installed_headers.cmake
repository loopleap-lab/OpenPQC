# installed_headers.cmake -- the test installed_headers: the installed headers stand on their own
#
#   cmake -DBUILD_DIR=<build> -DWORK=<scratch dir> -DCC=<C compiler> -DCXX=<C++ compiler> -P installed_headers.cmake
#
# Installs the build into <WORK>/prefix and checks every installed header:
#   - it lies under <prefix>/include/openpqc/ (the installation's include directory, OPENPQC_INSTALL_INCLUDEDIR);
#   - every #include "..." in it names a file of the installation: next to the header, or under
#     <prefix>/include/openpqc or <prefix>/include, the two include directories of the installed targets. No
#     installed header reaches into the source tree (src/: the scheme layers, the math cores, the GPU backends);
#   - it compiles alone against the installation and nothing else: a C header as C11 and as C++20, a C++ header as
#     C++20 (with -fsyntax-only). The headers that include <sycl/...>, themselves or through another installed
#     header, need a SYCL compiler and its flags and are left to the GPU tests; the first two checks hold for them
#     too.
# A positive control: a header that includes a file the installation does not have must be reported.
foreach(v BUILD_DIR WORK CC CXX)
    if(NOT ${v})
        message(FATAL_ERROR "installed_headers.cmake: -D${v}=... is required")
    endif()
endforeach()

set(prefix ${WORK}/prefix)
file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK})
execute_process(COMMAND ${CMAKE_COMMAND} --install ${BUILD_DIR} --prefix ${prefix}
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "cmake --install failed (${rc}):\n${out}\n${err}")
endif()
set(roots ${prefix}/include/openpqc ${prefix}/include)

# The quoted includes of a header that name no file of the installation
function(unresolved header out)
    file(STRINGS ${header} lines REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
    get_filename_component(dir ${header} DIRECTORY)
    set(missing "")
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*\"([^\"]+)\".*" "\\1" name "${line}")
        set(found FALSE)
        foreach(base ${dir} ${roots})
            if(EXISTS ${base}/${name})
                set(found TRUE)
                break()
            endif()
        endforeach()
        if(NOT found)
            list(APPEND missing ${name})
        endif()
    endforeach()
    set(${out} "${missing}" PARENT_SCOPE)
endfunction()

# Whether a header includes <sycl/...>, itself or through the installed headers it includes (memoized in global
# properties; a header already on the path counts as not needing SYCL, which ends include cycles)
function(needs_sycl header out)
    get_property(known GLOBAL PROPERTY "sycl:${header}" SET)
    if(known)
        get_property(v GLOBAL PROPERTY "sycl:${header}")
        set(${out} ${v} PARENT_SCOPE)
        return()
    endif()
    set_property(GLOBAL PROPERTY "sycl:${header}" FALSE)
    file(READ ${header} text)
    set(v FALSE)
    if(text MATCHES "#[ \t]*include[ \t]*<sycl/")
        set(v TRUE)
    else()
        file(STRINGS ${header} lines REGEX "^[ \t]*#[ \t]*include[ \t]*\"")
        get_filename_component(dir ${header} DIRECTORY)
        foreach(line IN LISTS lines)
            string(REGEX REPLACE "^[ \t]*#[ \t]*include[ \t]*\"([^\"]+)\".*" "\\1" name "${line}")
            foreach(base ${dir} ${roots})
                if(EXISTS ${base}/${name})
                    needs_sycl(${base}/${name} inner)
                    if(inner)
                        set(v TRUE)
                    endif()
                    break()
                endif()
            endforeach()
            if(v)
                break()
            endif()
        endforeach()
    endif()
    set_property(GLOBAL PROPERTY "sycl:${header}" ${v})
    set(${out} ${v} PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE headers LIST_DIRECTORIES FALSE ${prefix}/include/*)
list(LENGTH headers n_headers)
if(n_headers EQUAL 0)
    message(FATAL_ERROR "no header installed under ${prefix}/include: the check would pass on nothing")
endif()
set(problems "")
set(n_compiled 0)
set(n_sycl 0)
foreach(header IN LISTS headers)
    file(RELATIVE_PATH rel ${prefix}/include/openpqc ${header})
    if(rel MATCHES "^\\.\\./")
        list(APPEND problems "installed outside include/openpqc/: ${header}")
        continue()
    endif()
    unresolved(${header} missing)
    foreach(name IN LISTS missing)
        list(APPEND problems "${rel}: #include \"${name}\" is not part of the installation")
    endforeach()
    needs_sycl(${header} sycl)
    if(sycl)
        math(EXPR n_sycl "${n_sycl} + 1")
        continue()
    endif()
    set(compiles "")
    if(rel MATCHES "\\.h$")
        list(APPEND compiles "c|${CC}|-std=c11" "c++|${CXX}|-std=c++20")
    elseif(rel MATCHES "\\.hpp$")
        list(APPEND compiles "c++|${CXX}|-std=c++20")
    else()
        continue()
    endif()
    foreach(c IN LISTS compiles)
        string(REPLACE "|" ";" c "${c}")
        list(GET c 0 lang)
        list(GET c 1 compiler)
        list(GET c 2 std)
        set(tu ${WORK}/tu.${lang})
        if(lang STREQUAL "c++")
            set(tu ${WORK}/tu.cpp)
        endif()
        file(WRITE ${tu} "#include \"${rel}\"\n")
        execute_process(COMMAND ${compiler} -x ${lang} ${std} -fsyntax-only -I${prefix}/include/openpqc
                                -I${prefix}/include ${tu}
                        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
        if(NOT rc EQUAL 0)
            string(SUBSTRING "${err}" 0 600 err)
            list(APPEND problems "${rel} does not compile alone as ${lang} ${std}:\n${err}")
        else()
            math(EXPR n_compiled "${n_compiled} + 1")
        endif()
    endforeach()
endforeach()

# The positive control: a header of the installation's kind that includes a source file
set(control ${prefix}/include/openpqc/control_check.h)
file(WRITE ${control} "#include \"ML/KEM/scheme/ml_kem.hpp\"\n#include \"openpqc/common.h\"\n")
unresolved(${control} missing)
file(REMOVE ${control})
if(NOT missing STREQUAL "ML/KEM/scheme/ml_kem.hpp")
    list(APPEND problems "the control (an include of a source file) was not reported: '${missing}'")
endif()

message(STATUS "${n_headers} installed headers; every include resolved in the installation; ${n_compiled} "
               "compilations alone; ${n_sycl} SYCL headers checked for their includes only")
if(problems)
    list(JOIN problems "\n  " text)
    message(FATAL_ERROR "installed headers:\n  ${text}")
endif()
