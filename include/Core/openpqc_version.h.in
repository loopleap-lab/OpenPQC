/*
 * openpqc_version.h -- the version of OpenPQC, and the schemes this build of
 * the library contains (generated by CMake from Core/openpqc_version.h.in)
 *
 *   OPENPQC_VERSION_MAJOR, _MINOR, _PATCH, OPENPQC_VERSION_STRING
 *       the version this header comes with
 *   openpqc_version()
 *       the version of the library the program runs with, as a string
 *   OPENPQC_HAVE_MLKEM, OPENPQC_HAVE_MLDSA, OPENPQC_HAVE_SLHDSA
 *       1 if the library contains the scheme (the CMake options
 *       OPENPQC_WITH_MLKEM, _MLDSA, _SLHDSA), 0 if not
 *   OPENPQC_HAVE_SYCL
 *       1 if the GPU backends were built (library openpqc_sycl), 0 if not
 */

#ifndef OPENPQC_VERSION_H
#define OPENPQC_VERSION_H

#include "Core/opqc_common.h" /* OPENPQC_API, OPQC_EXTERN_C_BEGIN */

#define OPENPQC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define OPENPQC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define OPENPQC_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define OPENPQC_VERSION_STRING "@PROJECT_VERSION@"

#define OPENPQC_HAVE_MLKEM @OPENPQC_HAVE_MLKEM@
#define OPENPQC_HAVE_MLDSA @OPENPQC_HAVE_MLDSA@
#define OPENPQC_HAVE_SLHDSA @OPENPQC_HAVE_SLHDSA@
#define OPENPQC_HAVE_SYCL @OPENPQC_HAVE_SYCL_01@

OPQC_EXTERN_C_BEGIN

/* The version of the library the program is linked with, e.g. "0.3.0": a
 * program that ships with a shared library can compare it with
 * OPENPQC_VERSION_STRING. */
OPENPQC_API const char *openpqc_version(void);

OPQC_EXTERN_C_END

#endif /* !OPENPQC_VERSION_H */
