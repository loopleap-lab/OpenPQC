prefix=${pcfiledir}/@OPENPQC_PC_PREFIX_FROM_PCDIR@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@OPENPQC_INSTALL_INCLUDEDIR@

Name: OpenPQC SYCL
Description: OpenPQC's GPU backends (SYCL, @OPENPQC_SYCL_IMPL@): batched ML-KEM, ML-DSA and SLH-DSA, C APIs
URL: https://github.com/UCF-ML-Research/OpenPQC
Version: @PROJECT_VERSION@
Requires: openpqc
Cflags: -I${includedir} -I${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
Libs: -L${libdir} -lopenpqc_sycl
