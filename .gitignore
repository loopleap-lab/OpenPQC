# Build trees (build/, build-dpcpp/, build-acpp/, build-presets/ of CMakePresets.json, ...) and tool output
build*/
compile_commands.json
# a developer's own CMake presets (CMakePresets.json is the project's)
CMakeUserPresets.json
__pycache__/

# Hidden files and directories are local (.cache/, .claude/, .vscode/, .idea/, .original-src/,
# the original sources of the removed NTT learning library, ...), except the repository's own
.*
!.gitignore
!.dockerignore
!.gitmodules
!.gitattributes
!.github/
!.clang-format
!.clang-tidy
*.swp

# Logs and results generated on a local machine
*.log
*.stderr
bench/results/
perf.data*
vgcore.*
core.[0-9]*

# Notes, reports and plans that do not document the code as it is: the review and fix records, the SLH-DSA working
# notes, the toolchain-bug reproducers and local status reports stay on the machine that wrote them. The pages of
# docs/ that document the code are tracked.
docs/*
!docs/README.md
!docs/DOCUMENTATION.md
!docs/BUILDING.md
!docs/SECURITY-NOTES.md
!docs/GPU_ACCELERATION.md
!docs/SOURCE_MAP.md
!docs/PRIMITIVES.md
!docs/catalog/

# Images with locally measured NVIDIA cuPQC results: the cuPQC evaluation licence keeps such results private, so
# they stay local
figures/mlkem768_cpu_vs_gpu.png
figures/mlkem768_cpu_vs_gpu_rtxpro6000.png

# The upstream checkouts in reference/repos/ are submodules (.gitmodules) and are not ignored:
# git add needs to see them to record their commits
